+import assert from 'node:assert/strict'
+import fs from 'node:fs'
+import test from 'node:test'
+
+test('ZG-305Z exposes both USB endpoints as switches', () => {
+  const path = 'zhaquirks/hobeian/zg_305z.py'
+  const quirk = fs.existsSync(path) ? fs.readFileSync(path, 'utf8') : ''
+
+  assert.match(quirk, /QuirkBuilder\("HOBEIAN", "ZG-305Z"\)/)
+  assert.match(
+    quirk,
+    /replaces_endpoint\(1, device_type=zha\.DeviceType\.ON_OFF_OUTPUT\)/,
+    'endpoint 1 must be an on/off output',
+  )
+  assert.match(
+    quirk,
+    /replaces_endpoint\(2, device_type=zha\.DeviceType\.ON_OFF_OUTPUT\)/,
+    'endpoint 2 must be an on/off output',
+  )
+})
