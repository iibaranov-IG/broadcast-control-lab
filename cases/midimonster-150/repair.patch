index 939c742..b4ab728 100644
--- a/backends/osc.md
+++ b/backends/osc.md
@@ -52,6 +52,16 @@ a range between 0.0 and 2.0 (for example, an X-Y control), would look as follows
 /1/xy1 = ff 0.0 2.0 0.0 2.0
 ```
 
+To transmit an OSC request without arguments when a mapped input event arrives,
+use the special `query` format:
+
+```
+/ch/01/mix/fader = query
+```
+
+This emits the path followed by an empty OSC type tag (`,`). The value of the
+mapped input is used only as a trigger and is not included in the packet.
+
 To configure a range of faders, an expression similar to the following line could be used
 
 ```
diff --git a/configs/osc-query.cfg b/configs/osc-query.cfg
new file mode 100644
index 0000000..55d3214
--- /dev/null
+++ b/configs/osc-query.cfg
@@ -0,0 +1,16 @@
+; Send a value-less OSC query whenever the trigger receives an event.
+
+[backend osc]
+detect = on
+
+[osc trigger]
+bind = 127.0.0.1 19001
+/send = f 0.0 1.0
+
+[osc mixer]
+bind = 127.0.0.1 0
+destination = 127.0.0.1 19002
+/ch/01/mix/fader = query
+
+[map]
+trigger./send > mixer./ch/01/mix/fader
