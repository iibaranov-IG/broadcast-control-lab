diff --git a/t/test-const_str_hash.c b/t/test-const_str_hash.c
index 1ecfa5a5..21084eab 100644
--- a/t/test-const_str_hash.c
+++ b/t/test-const_str_hash.c
@@ -18,6 +18,27 @@ static int test_hash(char *p) {
 	// STR_LOOKUP("one") // catch duplicate
 }
 
+static int test_nested_hash(char *key, char *value) {
+	str k = STR(key);
+	str v = STR(value);
+
+	switch (__csh_lookup(&k)) {
+		case CSH_LOOKUP("before"):
+			return 1;
+		case CSH_LOOKUP("nested"):
+			switch (__csh_lookup_n(1, &v)) {
+				case CSH_LOOKUP_N(1, "value"):
+					return 2;
+				default:
+					return 0;
+			}
+		case CSH_LOOKUP("after"):
+			return 3;
+		default:
+			return 0;
+	}
+}
+
 static void test(char *p, int exp) {
 	int h = test_hash(p);
 	if (h != exp) {
@@ -31,5 +52,9 @@ int main(void) {
 	test("two", 2);
 	test("dashed-string", 3);
 	test("doesn't exist", 0);
+	if (test_nested_hash("before", "") != 1
+			|| test_nested_hash("nested", "value") != 2
+			|| test_nested_hash("after", "") != 3)
+		abort();
 	return 0;
 }
